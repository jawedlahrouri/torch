#!/usr/bin/env python3
import sys
import os

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path[:0] = [os.path.join(ROOT, "src"), os.path.join(ROOT, "src", "neural_network.py")]

def print_err(msg: str):
    sys.stderr.write(f"Error: {msg}\n")
    sys.exit(84)

def print_help():
    print(
        "USAGE\n"
        "        ./my_torch_analyzer [--predict | --train [--save SAVEFILE]] LOADFILE CHESSFILE\n\n"
        "DESCRIPTION\n"
        "        --train         Launch the neural network in training mode. Each chessboard in FILE must\n"
        "contain inputs to send to the neural network in FEN notation and the expected output separated by\n"
        "space. If specified, the newly trained neural network will be saved in SAVEFILE. Otherwise,\n"
        "it will be saved in the original LOADFILE.\n\n"
        "        --predict       Launch the neural network in prediction mode. Each chessboard in FILE must\n"
        "contain inputs to send to the neural network in FEN notation, and optionally an expected output.\n\n"
        "        --save          Save neural network into SAVEFILE. Only works in train mode.\n\n"
        "        LOADFILE        File containing an artificial neural network\n"
        "        CHESSFILE       File containing chessboards"
    )

def select_mods(args):
    mode = None
    savefile = None
    positional = []

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--train":
            if mode is not None:
                print_err("Conflicting modes.")
            mode = "train"
        elif arg == "--predict":
            if mode is not None:
                print_err("Conflicting modes.")
            mode = "predict"
        elif arg == "--save":
            if savefile is not None:
                print_err("--save specified twice.")
            if i + 1 >= len(args):
                print_err("Missing argument for --save.")
            savefile = args[i + 1]
            i += 1
        elif arg.startswith("-"):
            print_err(f"Unknown flag: {arg}")
        else:
            positional.append(arg)
        i += 1

    return mode, savefile, positional

def check_writable(path):
    d = os.path.dirname(os.path.abspath(path))
    if os.path.isdir(path) or not os.access(d, os.W_OK) \
            or (os.path.exists(path) and not os.access(path, os.W_OK)):
        print_err(f"Cannot write to {path}")

def check_network(nn, n_in, n_out):
    dense = nn.trainable_layers
    if not dense:
        raise ValueError("Invalid network: no dense layer.")
    for a, b in zip(dense, dense[1:]):
        if a.weights.shape[1] != b.weights.shape[0]:
            raise ValueError("Invalid network: layer sizes do not chain.")
    if dense[0].weights.shape[0] != n_in or dense[-1].weights.shape[1] != n_out:
        raise ValueError(
            f"Network has {dense[0].weights.shape[0]} inputs and {dense[-1].weights.shape[1]} outputs, "
            f"expected {n_in} and {n_out}.")

def save_atomic(nn, path):
    d, base = os.path.split(os.path.abspath(path))
    tmp = os.path.join(d, ".tmp_" + base)
    try:
        nn.save(tmp)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)

def write_stdout(text):
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)

def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print_help()
        sys.exit(0)

    mode, savefile, positional = select_mods(args)

    if mode is None:
        print_err("Must specify --train or --predict.")
    if mode == "predict" and savefile is not None:
        print_err("--save cannot be used with --predict.")
    if len(positional) != 2:
        print_err("Expected LOADFILE and CHESSFILE.")

    loadfile, chessfile = positional[0], positional[1]
    if not os.path.isfile(loadfile):
        print_err(f"LOADFILE does not exist: {loadfile}")
    if not os.path.isfile(chessfile):
        print_err(f"CHESSFILE does not exist: {chessfile}")

    try:
        import numpy as np
        from neural_network import NeuralNetwork
        from fen_parser import load_dataset, format_label, LABELS, N_FEATURES
    except ImportError as e:
        print_err(f"Cannot import modules: {e}")

    target_save = savefile if savefile is not None else loadfile
    if mode == "train":
        check_writable(target_save)

    try:
        nn = NeuralNetwork.load(loadfile)
        check_network(nn, N_FEATURES, len(LABELS))
        X, y, colors = load_dataset(chessfile, is_train=(mode == "train"))

        if mode == "train":
            nn.train(X, y, epochs=500, print_every=50)
            if not all(np.isfinite(l.weights).all() and np.isfinite(l.biases).all()
                       for l in nn.trainable_layers):
                print_err("Training diverged (NaN weights): network not saved.")
            save_atomic(nn, target_save)
        else:
            chunk = 4096
            preds = np.concatenate([nn.predict(X[i:i + chunk]) for i in range(0, len(X), chunk)])
            write_stdout("".join(format_label(int(p), c) + "\n" for p, c in zip(preds, colors)))
    except KeyboardInterrupt:
        print_err("Interrupted.")
    except Exception as e:
        print_err(str(e))

if __name__ == "__main__":
    main()

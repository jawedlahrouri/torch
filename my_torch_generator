#!/usr/bin/env python3
import sys
import os

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path[:0] = [os.path.join(ROOT, "src"), os.path.join(ROOT, "src", "neural_network.py")]
from neural_network import NeuralNetwork

EXIT_ERROR = 84
MIN_LAYERS = 2


def fail(msg: str):
    sys.stderr.write(f"Error: {msg}\n")
    sys.exit(EXIT_ERROR)

def print_help():
    print(
        "USAGE\n"
        "        ./my_torch_generator config_file_1 nb_1 [config_file_2 nb_2...]\n\n"
        "DESCRIPTION\n"
        "        config_file_i   Configuration file containing description of a neural network we want to\n"
        "generate.\n"
        "        nb_i            Number of neural networks to generate based on the configuration file."
    )

def parse_config(filepath: str) -> list[int]:
    try:
        with open(filepath, encoding="utf-8") as file:
            layers = [int(token) for token in file.read().replace(",", " ").split()]
        if len(layers) < MIN_LAYERS:
            raise ValueError(f"A network must have at least {MIN_LAYERS} layers.")
        if any(size <= 0 for size in layers):
            raise ValueError("Layer sizes must be positive.")
        return layers
    except Exception as error:
        fail(f"Invalid config file {filepath}: {error}")

def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print_help()
        sys.exit(0)

    if not args or len(args) % 2:
        fail("Invalid number of arguments (pairs of config_file nb expected).")

    jobs = []
    seen_names = set()
    for conf_path, count_text in zip(args[::2], args[1::2]):
        if not os.path.isfile(conf_path):
            fail(f"File not found: {conf_path}")

        try:
            count = int(count_text)
        except ValueError:
            count = 0
        if count <= 0:
            fail(f"Invalid number: {count_text}")

        layers = parse_config(conf_path)
        base_name = os.path.splitext(os.path.basename(conf_path))[0]
        if base_name in seen_names:
            fail(f"Output name collision: several config files named '{base_name}'.")
        seen_names.add(base_name)
        jobs.append((layers, base_name, count))

    # everything is validated: nothing is written if one pair is invalid
    for layers, base_name, count in jobs:
        for index in range(1, count + 1):
            out_filename = f"{base_name}_{index}.nn"
            try:
                NeuralNetwork(layers).save(out_filename)
            except Exception as error:
                fail(f"Failed to generate {out_filename}: {error}")

if __name__ == "__main__":
    main()
